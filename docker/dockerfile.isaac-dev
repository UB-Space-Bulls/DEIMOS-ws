# =============================================================================
# dockerfile.isaac-dev — x86_64 GPU sandbox for the Isaac ROS VSLAM pull-forward
# validation detour (see CLAUDE.md's SLAM go/no-go plan).
#
# NOT one of the project's three standing images (dockerfile.dev/.basestation/
# .jetson) and not wired into their conventions on purpose — this is a
# throwaway harness to answer one question early: does isaac_ros_visual_slam
# (cuVSLAM), fed by a ZED stereo camera, work well enough on a discrete GPU
# to be worth betting on for the Orin in December? If yes, this container's
# job is done and the real work happens in dockerfile.jetson. If no, no
# changes needed anywhere else — slam_toolbox stays primary as documented.
#
# Requires on the HOST (not this Dockerfile's job):
#   - An x86_64 machine with a real NVIDIA GPU, Ampere architecture or newer
#     (RTX 4050 = Ada Lovelace, qualifies)
#   - NVIDIA driver 580+ (the driver itself lives on the host; the container
#     only needs the CUDA *toolkit*, injected against the host driver at
#     `docker run` time via the NVIDIA Container Toolkit)
#   - NVIDIA Container Toolkit installed + configured (`nvidia-ctk runtime
#     configure`) so `docker run --gpus all` actually exposes the GPU --
#     this is a different mechanism than dockerfile.dev's `--device /dev/dri`,
#     which is display-only (Mesa/OpenGL for RViz/Gazebo windows) and does
#     NOT expose CUDA compute
#   - A ZED 2 camera connected via USB3
#
# Version pins: the zed-sdk-check stage installs CUDA 13.0 *runtime* libs +
# ZED SDK 5.2 (driver 580+ on the host). The `full` stage then pulls Isaac ROS
# 4.6, whose ros-jazzy-isaac-ros-common Depends drags in cuda-toolkit-13-2 and
# libnvvpi4 (VPI 4, from the Jetson r39.2 x86_64 repo); cuDNN/TensorRT are
# deliberately NOT installed (cuVSLAM 4.6 doesn't depend on them). All of this
# moves fast -- re-check https://nvidia-isaac-ros.github.io/getting_started and
# https://www.stereolabs.com/developers/release before building if this file
# sits unused for a while.
#
# CHECKPOINT -- do not skip: build and manually verify the `zed-sdk-check`
# stage BEFORE building the full image. There are unresolved forum reports
# of ZED SDK 5.2 breaking (Depth View/Sensors/Diagnostics/Python API all
# fail, only ZED Explorer works) on Ubuntu 24.04 + CUDA 13.0 for at least
# one ZED camera model -- unconfirmed whether that's model-specific or a
# broader SDK/OS combo bug, so verify against the actual ZED 2 before
# spending time on the zed-ros2-wrapper + Isaac ROS layers on top of it.
#
#   docker build -f docker/dockerfile.isaac-dev --target zed-sdk-check \
#       -t rover-isaac-dev:zed-check .
#   docker run -it --rm --gpus all --privileged \
#       -e DISPLAY="$DISPLAY" -v /tmp/.X11-unix:/tmp/.X11-unix \
#       rover-isaac-dev:zed-check bash
#   # inside the container:
#   /usr/local/zed/tools/ZED_Explorer
#   /usr/local/zed/tools/ZED_Diagnostic
#
# Only once that passes, build the full image (reuses the cached
# zed-sdk-check layers, so this is cheap):
#
#   docker build -f docker/dockerfile.isaac-dev -t rover-isaac-dev .
# =============================================================================

FROM ros:jazzy-ros-base AS zed-sdk-check

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=jazzy

# -----------------------------------------------------------------------------
# Dev tooling
# zstd is REQUIRED, not optional: the ZED SDK 5.2 installer is a
# zstd-compressed makeself archive (ZED_SDK_..._v5.2.3.zstd.run). Without the
# `zstd` binary on PATH its self-extraction fails with "Extraction failed"
# and the script exits 15 -- the installer even prints
# "Use 'sudo apt install zstd' if zstd is not found". Older ZED SDK .run
# files were gzip/xz; 5.2 switched to zstd.
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential git git-lfs curl wget vim nano \
    python3-pip python3-venv \
    lsb-release software-properties-common \
    zstd \
    ros-dev-tools \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# CUDA 13.0 RUNTIME LIBRARIES ONLY -- not the full toolkit.
#
# The `zed-sdk-check` stage only has to run ZED_Explorer / ZED_Diagnostic,
# which link the CUDA runtime + a few math libs. The full `cuda-toolkit-13-0`
# meta-package is ~7GB: it drags in nvcc, Nsight, GPUDirect Storage
# (`cuda-13.0/gds/*`), profilers, docs and samples -- none of it reachable
# from ZED_Explorer, and it ENOSPC'd this 47GB root partition mid-extract.
# The driver itself stays on the host and is injected by the NVIDIA Container
# Toolkit at `docker run --gpus all` time; it is never installed here.
#
# This is the minimum runtime set; ZED SDK links cudart + cuBLAS/cuFFT/cuRAND
# and uses nvRTC for kernel JIT. If ZED_Explorer fails at the checkpoint with
# a missing `.so`, add exactly that one `cuda-*-13-0` / `libcu*-13-0` package
# and rebuild -- don't widen this list pre-emptively.
#
# NOTE: the `full` stage needs nvcc + CUDA dev headers to build zed-ros2-wrapper
# -- it gets them back automatically, because ros-jazzy-isaac-ros-common Depends
# on cuda-toolkit-13-2 and apt pulls the whole toolkit in as a dependency there.
#
# VERIFY: cuda-keyring version + exact package names against
# https://developer.nvidia.com/cuda-downloads (Linux x86_64, Ubuntu 24.04,
# deb (network)) -- these bump often.
# -----------------------------------------------------------------------------
RUN wget https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/cuda-keyring_1.1-1_all.deb \
    && dpkg -i cuda-keyring_1.1-1_all.deb \
    && rm cuda-keyring_1.1-1_all.deb \
    && apt-get update && apt-get install -y --no-install-recommends \
       cuda-cudart-13-0 \
       cuda-nvrtc-13-0 \
       libcublas-13-0 \
       libcufft-13-0 \
       libcurand-13-0 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sfn /usr/local/cuda-13.0 /usr/local/cuda \
    && echo /usr/local/cuda/lib64 > /etc/ld.so.conf.d/cuda.conf \
    && ldconfig
# The runtime .deb packages install under /usr/local/cuda-13.0/ but do NOT
# create the /usr/local/cuda symlink (that comes from the full toolkit
# meta-package we dropped) -- create it by hand so the paths below resolve.
# ldconfig (above) already registers /usr/local/cuda/lib64, so LD_LIBRARY_PATH
# isn't strictly needed -- set it anyway for tools that read it directly.
# ${LD_LIBRARY_PATH:+:...} avoids a dangling ':' (and a build warning) when the
# base image leaves the var unset.
ENV PATH=/usr/local/cuda/bin:${PATH}
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}

# -----------------------------------------------------------------------------
# ZED SDK 5.2
# Stereolabs ships this as a versioned .run installer (a makeself self-extractor),
# not an apt package -- the download URL encodes CUDA version + Ubuntu version,
# so it has to match the CUDA 13.0 / Ubuntu 24.04 combo installed above.
# VERIFY: exact SDK build URL against https://www.stereolabs.com/developers/release
#
# Flags passed after `--` go to the embedded install script:
#   silent          - accept the EULA, no interactive prompts (required: no TTY
#                     in `docker build`; without it the installer stalls on a
#                     prompt and gets killed -- SIGTERM / exit 15)
#   skip_cuda       - we already installed the CUDA 13.0 runtime libs above;
#                     stop the installer trying to apt-install its own CUDA on top
#   skip_python     - the Python API; zed-ros2-wrapper is C++, doesn't need it
#   skip_od_module  - the object-detection / neural-depth AI models: multi-GB,
#                     pulled over the network at install time, and unused by
#                     cuVSLAM or by this checkpoint. Dropping them is what keeps
#                     this stage inside a tight root partition.
# Do NOT add `skip_tools` -- ZED_Explorer / ZED_Diagnostic ARE the checkpoint.
#
# wget -nv (not -q) so a truncated download shows up in the build log as a
# size mismatch rather than surfacing later as a confusing "Extraction failed".
# -----------------------------------------------------------------------------
RUN wget -nv 'https://download.stereolabs.com/zedsdk/5.2/cu13/ubuntu24' -O ZED_SDK_Linux.run \
    && ls -lh ZED_SDK_Linux.run \
    && chmod +x ZED_SDK_Linux.run \
    && ./ZED_SDK_Linux.run -- silent skip_cuda skip_python skip_od_module \
    && rm ZED_SDK_Linux.run

# ============================= CHECKPOINT ==================================
# Build up to here with --target zed-sdk-check and manually verify the ZED 2
# against ZED_Explorer/ZED_Diagnostic (see header) before continuing past
# this point. Everything below assumes that passed.
# =============================================================================

FROM zed-sdk-check AS full

# -----------------------------------------------------------------------------
# Two more NVIDIA apt repos are needed on x86_64 for the Isaac ROS layer.
# (Jetson images get all of this from the bundled Jetson APT repo; a plain
# x86_64 ros:jazzy-ros-base has none of it.) Per
# https://nvidia-isaac-ros.github.io/getting_started :
#
#   1. CUDA repo          -- already added in the zed-sdk-check stage.
#   2. Isaac ROS repo     -- the ros-jazzy-isaac-ros-* debians themselves.
#                            NOT in packages.ros.org: an earlier version of
#                            this file wrongly assumed they were -- against a
#                            plain ros:jazzy-ros-base, `apt-cache policy
#                            ros-jazzy-isaac-ros-visual-slam` resolves nothing
#                            while ros-jazzy-nav2-* resolves fine.
#   3. Jetson x86_64 repo -- provides libnvvpi4 / vpi4-dev (NVIDIA VPI 4), a
#                            hard Depends of ros-jazzy-isaac-ros-common that is
#                            in NEITHER the CUDA repo nor the Isaac ROS repo.
#                            The "r39.2" suite matches JetPack 7.2 / Jetson
#                            Linux 39.2 -- the exact release the rover's Orin
#                            runs (CLAUDE.md) -- so the VPI here lines up with
#                            what dockerfile.jetson uses on target. The repo's
#                            own Release file labels it "L4T Jetson host
#                            components" -- i.e. built for exactly this
#                            x86-dev-host-for-a-Jetson-target case.
#
# gnupg isn't in the base stage's apt list (adding it there would bust the
# cached zed-sdk-check layers), so install it here first.
# VERIFY all of: "release-4.6" (swap for "release-4" to track latest 4.x),
# "r39.2", and both key URLs against the Isaac ROS getting-started page --
# NVIDIA bumps these dirs regularly.
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends gnupg ca-certificates \
    && curl -fsSL https://isaac.download.nvidia.com/isaac-ros/repos.key \
       | gpg --dearmor -o /usr/share/keyrings/nvidia-isaac-ros.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/nvidia-isaac-ros.gpg] https://isaac.download.nvidia.com/isaac-ros/release-4.6 noble main" \
       > /etc/apt/sources.list.d/nvidia-isaac-ros.list \
    && curl -fsSL https://repo.download.nvidia.com/jetson/jetson-ota-public.asc \
       | gpg --dearmor -o /usr/share/keyrings/nvidia-jetson.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/nvidia-jetson.gpg] https://repo.download.nvidia.com/jetson/x86_64/noble r39.2 main" \
       > /etc/apt/sources.list.d/nvidia-jetson.list \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# isaac_ros_visual_slam + isaac_ros_common (and everything they pull in).
#
# Let apt solve the whole CUDA / cuDNN / TensorRT / VPI graph in ONE pass off
# the Isaac ROS package metadata -- do NOT hand-install cuda-toolkit / cuDNN /
# TensorRT first:
#   - ros-jazzy-isaac-ros-common's Depends pins `cuda-toolkit-13-2` exactly
#     (not the 13-0 *runtime* libs the checkpoint stage installed). Letting it
#     pull that in also restores nvcc + CUDA dev headers -- which is what
#     zed-ros2-wrapper needs to compile -- so a separate "dev toolchain" step
#     isn't needed.
#   - cuVSLAM 4.6 does NOT declare cuDNN or TensorRT as dependencies at all.
#     An unpinned `tensorrt` meta currently resolves to 11.2 / cuda13.3 and
#     would drag a *third* CUDA minor into the image for nothing. If a runtime
#     "missing libnvinfer" ever surfaces, add exactly the TensorRT build Isaac
#     ROS asks for at that point, pinned.
#
# Then repoint /usr/local/cuda from the 13.0 tree the checkpoint symlinked to
# the 13.2 tree Isaac ROS just installed, and refresh the linker cache.
#
# Heavy step: the visual-slam .deb alone is ~560MB, and with NITROS /
# image-proc / interfaces + cuda-toolkit-13-2 this pulls several GB -- the
# first build of this layer is long.
# VERIFY: `apt-cache policy ros-jazzy-isaac-ros-visual-slam` should show the
# isaac.download.nvidia.com origin and a 4.6.x version.
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
       ros-jazzy-isaac-ros-common \
       ros-jazzy-isaac-ros-visual-slam \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sfn /usr/local/cuda-13.2 /usr/local/cuda \
    && ldconfig

# -----------------------------------------------------------------------------
# Build dependencies for zed-ros2-wrapper (v5.2.x).
# Nothing here runs `rosdep`, so the wrapper's package.xml deps that aren't
# already dragged in by ros-base or the Isaac ROS layer have to be listed by
# hand -- same manual-sync footgun as dockerfile.dev (see CLAUDE.md). This set
# is every REQUIRED find_package() in zed_components / zed_wrapper that was
# missing from the image; add to it if a later `colcon build` still fails on a
# "Could not find a package configuration file" for something else.
#   nlohmann-json3-dev  -- provides nlohmann_jsonConfig.cmake (NOT a ros- pkg)
#   *-image-transport / point-cloud-transport -- the wrapper publishes
#       compressed + Theora image streams and point clouds
#   robot_localization  -- the wrapper ships an ekf fusion node + config
#   xacro               -- expands the camera URDF at launch
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
       nlohmann-json3-dev \
       ros-jazzy-xacro \
       ros-jazzy-nmea-msgs \
       ros-jazzy-geographic-msgs \
       ros-jazzy-diagnostic-updater \
       ros-jazzy-robot-localization \
       ros-jazzy-backward-ros \
       ros-jazzy-image-transport \
       ros-jazzy-image-transport-plugins \
       ros-jazzy-compressed-image-transport \
       ros-jazzy-compressed-depth-image-transport \
       ros-jazzy-theora-image-transport \
       ros-jazzy-point-cloud-transport \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# Workspace
# The ZED packages aren't in apt -- clone them into the bind-mounted
# rover_ws/src on the host (same convention as any other source-built package
# here) and colcon build inside the container, rather than baking them in.
# Pin the tags to the ZED SDK version installed above (5.2):
#   git clone -b v5.2.2 https://github.com/stereolabs/zed-ros2-wrapper.git
#   git clone -b 5.2.1  https://github.com/stereolabs/zed-ros2-interfaces.git
# zed-ros2-interfaces provides zed_msgs, which the wrapper build needs.
# NOTE: `zed_description` (exec_depend of zed_wrapper/zed_ros2) is in neither
# repo above -- only needed to `ros2 launch` the wrapper's display, not to
# build or to run isaac_ros_visual_slam. Clone zed-ros2-examples for it if a
# launch file complains.
# -----------------------------------------------------------------------------
ENV ROS_WS=/workspaces/rover_ws
RUN mkdir -p ${ROS_WS}/src
WORKDIR ${ROS_WS}

RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /etc/bash.bashrc && \
    echo "[ -f ${ROS_WS}/install/setup.bash ] && source ${ROS_WS}/install/setup.bash" >> /etc/bash.bashrc

# -----------------------------------------------------------------------------
# Entrypoint
# No Zenoh here on purpose -- this container isn't talking to the rover
# network, it's a standalone perception validation box. Default RMW is fine.
# -----------------------------------------------------------------------------
COPY docker/ros_entrypoint.sh /
RUN chmod +x /ros_entrypoint.sh
ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
