# =============================================================================
# Dockerfile.dev — Portable x86_64 dev environment
# ROS 2 Jazzy + Nav2 + MoveIt 2 + ros2_control + Zenoh + Gazebo Harmonic
# For writing and unit-testing Jetson-bound code on any laptop (Win/Mac/Linux,
# GPU or no GPU). Deliberately does NOT include Isaac ROS's GPU-accelerated
# perception packages — those need real Tegra hardware. This image is safe to
# break; it's isolated from Dockerfile.basestation on purpose.
# =============================================================================

FROM ros:jazzy-ros-base

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=jazzy

# -----------------------------------------------------------------------------
# Dev tooling
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential git curl wget vim nano sudo \
    python3-pip python3-venv \
    ros-dev-tools \
    ros-jazzy-ament-lint-auto \
    ros-jazzy-ament-lint-common \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# Nav2 / MoveIt 2 / ros2_control
# (Same package set as the Jetson image, so code written here transfers with
# minimal changes — this is the whole point of this image.)
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-navigation2 \
    ros-jazzy-nav2-bringup \
    ros-jazzy-moveit \
    ros-jazzy-ros2-control \
    ros-jazzy-ros2-controllers \
    ros-jazzy-joint-state-publisher \
    ros-jazzy-joint-state-publisher-gui \
    ros-jazzy-rviz2 \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# Zenoh RMW
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-rmw-zenoh-cpp \
    && rm -rf /var/lib/apt/lists/*
ENV RMW_IMPLEMENTATION=rmw_zenoh_cpp
# Safe here because this image is a single self-contained dev machine, not
# part of the real base-station <-> rover network -- see ros_entrypoint.sh.
ENV ZENOH_ROUTER_AUTOSTART=1

# -----------------------------------------------------------------------------
# Simulation — Gazebo Harmonic
# ros-jazzy-ros-gz bridges ROS 2 topics/services/TF to Gazebo (Jazzy's default
# paired Gazebo release is Harmonic). gz-ros2-control lets ros2_control drive
# the simulated robot the same way it'll drive real hardware, so controller
# definitions stay swappable between sim and the Jetson per CLAUDE.md.
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-ros-gz \
    ros-jazzy-gz-ros2-control \
    ros-jazzy-teleop-twist-keyboard \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------------------------------------------------
# Workspace
# -----------------------------------------------------------------------------
ENV ROS_WS=/workspaces/rover_ws
RUN mkdir -p ${ROS_WS}/src
WORKDIR ${ROS_WS}

# Bind-mount your local rover_ws/src here at `docker run` time for active
# development, rather than COPY-ing it in — you want live edits to show up
# without rebuilding the image every time.

# -----------------------------------------------------------------------------
# Non-root dev user
# `run-dev.sh` runs the container with `--user $(id -u):$(id -g)` so files
# `colcon build` writes into the bind-mounted rover_ws come out host-owned
# instead of root-owned (see CLAUDE.md's "Host vs. container UID mismatch"
# footgun). But a container that only has `root` defined has no account for
# that host UID to land on: no $HOME, no shell identity, and no sudo -- so
# mid-session `apt-get install` and anything else expecting a real user
# breaks. Baking in an actual `dev` account fixes that. Default UID/GID 1000
# matches the first-user default on a fresh single-user Linux or WSL2 box; if
# your host UID differs, rebuild with
# `--build-arg USER_UID=$(id -u) --build-arg USER_GID=$(id -g)`.
# -----------------------------------------------------------------------------
ARG USER_UID=1000
ARG USER_GID=1000
RUN groupadd -g ${USER_GID} dev \
    && useradd -m -u ${USER_UID} -g ${USER_GID} -s /bin/bash dev \
    && echo "dev ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/dev \
    && chmod 0440 /etc/sudoers.d/dev \
    && chown -R dev:dev ${ROS_WS}

# ros_entrypoint.sh only sources ROS for the container's first process, so a
# second terminal opened via `docker exec -it <container> bash` skips it and
# gets a bare shell (no `ros2` command, no workspace packages). Sourcing from
# /etc/bash.bashrc instead covers every interactive bash shell in the
# container, exec'd or not -- this is in addition to, not instead of,
# ros_entrypoint.sh, which still handles the non-interactive-command case
# (e.g. `docker run rover-dev ros2 launch ...`) that never reads bashrc at all.
RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /etc/bash.bashrc && \
    echo "[ -f ${ROS_WS}/install/setup.bash ] && source ${ROS_WS}/install/setup.bash" >> /etc/bash.bashrc

# -----------------------------------------------------------------------------
# Entrypoint
# -----------------------------------------------------------------------------
COPY docker/ros_entrypoint.sh /
RUN chmod +x /ros_entrypoint.sh

USER dev

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
