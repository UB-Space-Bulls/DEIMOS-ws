<?xml version="1.0" ?>
<robot name="rover_test" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<xacro:property name="body_color" value="Gazebo/Silver" />

<gazebo reference="base_link">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
  <gravity>true</gravity>
</gazebo>

<xacro:macro name="module_surface" params="prefix">
  <gazebo reference="${prefix}_steer_link">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>true</self_collide>
  </gazebo>
  <gazebo reference="${prefix}_wheel_link">
    <material>${body_color}</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <self_collide>true</self_collide>
  </gazebo>
</xacro:macro>

<xacro:module_surface prefix="rear_left"/>
<xacro:module_surface prefix="front_left"/>
<xacro:module_surface prefix="rear_right"/>
<xacro:module_surface prefix="front_right"/>

</robot>
