Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Name: Camera frames
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.2
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true
    - Class: rviz_default_plugins/Image
      Name: RGB
      Enabled: true
      Normalize Range: true
      Queue Size: 2
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /zed2/zed_node/rgb/color/rect/image
      Transport Hint: raw
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Depth (meters)
      Enabled: true
      Normalize Range: true
      Queue Size: 2
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /zed2/zed_node/depth/depth_registered
      Transport Hint: raw
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Registered point cloud
      Enabled: true
      Alpha: 1
      Color Transformer: RGB8
      Position Transformer: XYZ
      Decay Time: 0
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.01
      Style: Points
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /zed2/zed_node/point_cloud/cloud_registered
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Camera odometry
      Enabled: true
      Keep: 50
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
      Shape: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /zed2/zed_node/odom
      Value: true
  Enabled: true
  Global Options:
    Background Color: 32; 35; 42
    Fixed Frame: zed2_odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 5
      Pitch: 0.45
      Yaw: 0.8
      Target Frame: <Fixed Frame>
      Focal Point:
        X: 1
        Y: 0
        Z: 0
Window Geometry:
  Width: 1400
  Height: 900
