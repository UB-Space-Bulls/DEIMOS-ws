# =========================
# ROS 2 / Colcon
# =========================
build/
install/
log/

# Third-party ROS source cloned into the workspace for the isaac-dev sandbox
# (see docker/dockerfile.isaac-dev + docker/run-isaac-dev.sh). External repos
# pinned to a tag, colcon-built inside the container -- not part of this
# repo's history.
/rover_ws/src/zed-ros2-wrapper/
/rover_ws/src/zed-ros2-interfaces/
/rover_ws/src/zed-ros2-description/

# run-isaac-dev.sh sets HOME=/workspaces/rover_ws (so --user has a writable
# home), which lands these container-side dotfiles in the bind-mounted ws.
/rover_ws/.bash_history
/rover_ws/.ros/
/rover_ws/.config/

